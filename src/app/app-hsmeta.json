{
  "uid": "extole_hs_app",
  "type": "app",
  "config": {
    "description": "Connects HubSpot to Extole's referral platform. Captures referral attribution at form submission, fires CRM events to Extole, and supports bulk contact enrollment.",
    "name": "Extole",
    "distribution": "private",
    "auth": {
      "type": "static",
      "requiredScopes": [
        "oauth",
        "crm.objects.contacts.read",
        "crm.objects.contacts.write",
        "crm.schemas.contacts.read",
        "crm.schemas.contacts.write",
        "crm.objects.deals.read",
        "crm.schemas.deals.read",
        "crm.objects.companies.read",
        "crm.schemas.companies.read",
        "tickets",
        "automation",
        "crm.schemas.custom.read",
        "crm.schemas.custom.write",
        "crm.objects.custom.read",
        "crm.objects.custom.write",
        "forms"
      ],
      "optionalScopes": [],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": [
        "https://api.hubapi.com",
        "https://api.extole.io"
      ],
      "iframe": [],
      "img": []
    },
    "support": {
      "supportEmail": "support@extole.com",
      "documentationUrl": "https://docs.extole.com",
      "supportUrl": "https://docs.extole.com",
      "supportPhone": ""
    }
  }
}
